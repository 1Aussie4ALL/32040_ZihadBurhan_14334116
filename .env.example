# Copy to .env and adjust before running docker compose.
# These are development-only defaults. Replace before any non-local use.

POSTGRES_USER=careprior
POSTGRES_PASSWORD=careprior
POSTGRES_DB=careprior

# Shared secret used to sign/verify JWTs across all backend services.
# MUST be replaced with a long random value outside local development.
JWT_SECRET=dev-insecure-secret-change-me

# AI provider selection. Only "mock" is implemented in this build (deterministic,
# no external API calls, no cost). A real Anthropic/OpenAI-compatible adapter can be
# added later behind the same AIProvider interface without touching domain logic.
AI_PROVIDER=mock

# Only required if a real provider adapter is added later. Not used by the mock provider.
ANTHROPIC_API_KEY=

NEXT_PUBLIC_API_URL=http://localhost:8000
