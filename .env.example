# Copy to .env before running the app. Defaults below are safe for local demo use.

# SQLite database file (created automatically by `npx prisma migrate dev`)
DATABASE_URL="file:./dev.db"

# AI provider selection. "mock" (default) is fully deterministic, free, and requires
# no external calls — the whole app works end-to-end without this section at all.
# Set to "claude" and provide ANTHROPIC_API_KEY to use a real model instead.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# Session signing secret for the clinician dashboard demo login.
# Replace with a long random value outside local development.
SESSION_SECRET=dev-only-insecure-secret-change-me
