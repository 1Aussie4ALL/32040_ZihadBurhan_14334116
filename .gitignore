# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any depth — _archive/ holds an earlier build with its own tree)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js (any depth)
.next/
out/

# production
build/

# python artifacts (the archived v1 build included FastAPI services)
__pycache__/
*.py[cod]
.venv/
venv/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database (generated — schema lives in prisma/schema.prisma + migrations/)
/prisma/dev.db
/prisma/dev.db-journal
*.db
*.db-journal
